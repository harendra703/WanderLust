<% layout("/layouts/boilerplate")%>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <%for(let listing of allListings){%>
                <a href="/listings/<%=listing._id%>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%=listing.image.url%>" class="card-img-top " alt="Listing-image"
                            style="height:20rem">
                        <div class="card-body">
                            <div class="card-img-overlay">
                                <!-- <%=listing.description%> -->
                            </div>
                            <p class="card-text">
                                <b>
                                    <%=listing.title%>
                                </b>
                                <br>
                                &#8377; <%= listing.price.toLocaleString()%> / night
                                <i class="tex-info">&nbsp;+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <%}%>
        </div>
    </body>

    <script>
        let textSwitch = document.getElementById("switchCheckDefault");
        textSwitch.addEventListener("click",()=>{
            let textInfo = document.getElementsByClassName("tex-info");
            for(info of textInfo){
                if(info.style.display != "inline"){
                    info.style.display = "inline";
                } else{
                    info.style.display = "none";
                }
            }
        })
    </script>